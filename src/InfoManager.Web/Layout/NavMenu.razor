<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Width="250" Collapsible="true" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
             <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">Home</FluentNavLink>
             <FluentNavLink Href="categories/list" Icon="@(new Icons.Regular.Size20.List())" IconColor="Color.Accent">Danh mục</FluentNavLink>
            <FluentNavLink Href="experiences/list" Icon="@(new Icons.Regular.Size20.LearningApp())" IconColor="Color.Accent">Kinh nghiệm</FluentNavLink>
            <FluentNavGroup Title="Gia đình" Icon="@(new Icons.Regular.Size20.People())" IconColor="Color.Accent">
                <FluentNavLink Href="families/list" Icon="@(new Icons.Regular.Size20.People())" IconColor="Color.Accent">Thành viên gia đình</FluentNavLink>
                <FluentNavLink Href="families/Events/list" Icon="@(new Icons.Regular.Size20.FoodCake())" IconColor="Color.Accent">Sự kiện gia đình</FluentNavLink>
                <FluentNavLink Href="families/Relations/list" Icon="@(new Icons.Regular.Size20.PeopleCommunity())" IconColor="Color.Accent">Mối quan hệ gia đình</FluentNavLink>
            </FluentNavGroup>
            <FluentNavLink Href="HistoricalEvents/list" Icon="@(new Icons.Regular.Size20.History())" IconColor="Color.Accent">Sự kiện lịch sử</FluentNavLink>
            <FluentNavLink Href="Intentions/list" Icon="@(new Icons.Regular.Size20.Lightbulb())" IconColor="Color.Accent">Ý định</FluentNavLink>
            <FluentNavLink Href="PriceTrackings/list" Icon="@(new Icons.Regular.Size20.Money())" IconColor="Color.Accent">Theo dõi giá</FluentNavLink>
            <FluentNavLink Href="Transactions/list" Icon="@(new Icons.Regular.Size20.ShoppingBag())" IconColor="Color.Accent">Giao dịch</FluentNavLink>
            <FluentNavGroup Title="Quản lý người dùng" Icon="@(new Icons.Regular.Size20.Person())" IconColor="Color.Accent">
                <FluentNavLink Href="account/users/list" Icon="@(new Icons.Regular.Size20.People())" IconColor="Color.Accent">Danh sách người dùng</FluentNavLink>
                <FluentNavLink Href="account/roles/list" Icon="@(new Icons.Regular.Size20.ShieldPerson())" IconColor="Color.Accent">Danh sách vai trò</FluentNavLink>
            </FluentNavGroup>
        </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
}
