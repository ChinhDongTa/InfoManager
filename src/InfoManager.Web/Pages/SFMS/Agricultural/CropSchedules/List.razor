@page "/sfms/agricultural/crop-schedules/list"
@inject IAgriculturalService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách lịch canh tác" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/agricultural/crop-schedules/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="CropScheduleSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="string" Title="Tên lịch" Property="@(x => x.ScheduleName)" />
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="string" Title="Cây trồng" Property="@(x => x.CropName)" />
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="string" Title="Giống cây" Property="@(x => x.CropVarietyName)" />
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="string" Title="Vụ trồng" Property="@(x => x.PlantingSeason)" />
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="int" Title="Số ngày đến thu hoạch" Property="@(x => x.DaysToHarvest)" />
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="decimal?" Title="Năng suất dự kiến" Property="@(x => x.ExpectedYield)" />
            <PropertyColumn TGridItem="CropScheduleSummaryDto" TProp="bool" Title="Đang sử dụng" Property="@(x => x.IsActive)" />
            <TemplateColumn TGridItem="CropScheduleSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<CropScheduleSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetCropSchedulesAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Crop schedules"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetCropSchedulesAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Crop schedules"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/agricultural/crop-schedules/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/agricultural/crop-schedules/update/{id}");
    }
}