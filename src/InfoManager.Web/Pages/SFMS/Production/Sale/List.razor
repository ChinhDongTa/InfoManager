@page "/sfms/production/sale/list"
@inject ISaleService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách đơn bán" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/production/sale/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="SaleSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="SaleSummaryDto" TProp="string" Title="Sản phẩm" Property="@(x => x.ProductName)" />
            <PropertyColumn TGridItem="SaleSummaryDto" TProp="DateTimeOffset" Title="Ngày bán" Property="@(x => x.SaleDate)" />
            <PropertyColumn TGridItem="SaleSummaryDto" TProp="string" Title="Người mua" Property="@(x => x.BuyerName)" />
            <PropertyColumn TGridItem="SaleSummaryDto" TProp="decimal" Title="Số lượng bán" Property="@(x => x.QuantitySold)" />
            <PropertyColumn TGridItem="SaleSummaryDto" TProp="decimal" Title="Thực nhận" Property="@(x => x.NetAmount)" />
            <PropertyColumn TGridItem="SaleSummaryDto" TProp="string" Title="Thanh toán" Property="@(x => x.PaymentStatusName)" />
            <TemplateColumn TGridItem="SaleSummaryDto" Context="item" Title="Actions" Class="col-actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<SaleSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetSalesAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Sales"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetSalesAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Sales"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/production/sale/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/production/sale/update/{id}");
    }
}