@page "/sfms/production/harvest/list"
@inject IHarvestService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách thu hoạch" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <FluentStack Orientation="Orientation.Vertical">
            <LoadingOverlay IsLoading="isLoading" />
            <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/production/harvest/create"))>
                Tạo mới
            </FluentButton>
            <PaginatedTable TItem="HarvestSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="string" Title="Mã lần trồng" Property="@(x => x.PlantingCode)" />
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="string" Title="Cây trồng" Property="@(x => x.CropName)" />
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="DateTimeOffset" Title="Ngày thu hoạch" Property="@(x => x.HarvestDate)" />
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="decimal" Title="Tổng sản lượng" Property="@(x => x.TotalQuantity)" />
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="string" Title="Đơn vị" Property="@(x => x.QuantityUnit)" />
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="decimal?" Title="Năng suất / ha" Property="@(x => x.YieldPerHectare)" />
                <PropertyColumn TGridItem="HarvestSummaryDto" TProp="string" Title="Phân loại chất lượng" Property="@(x => x.QualityGrade)" />
                <TemplateColumn TGridItem="HarvestSummaryDto" Context="item" Title="Actions" Class="col-actions">
                    <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                    <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
                </TemplateColumn>
            </PaginatedTable>
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<HarvestSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetHarvestsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Harvests"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetHarvestsAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Harvests"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/production/harvest/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/production/harvest/update/{id}");
    }
}