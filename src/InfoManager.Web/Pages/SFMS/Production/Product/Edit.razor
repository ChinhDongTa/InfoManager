@page "/sfms/production/product/update/{Id}"
@page "/sfms/production/product/create/"

@inject IProductService service

<PageHeader Title="Quản lý sản phẩm" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentLabel Typo="Typography.H4">
            @title
        </FluentLabel>
        @if (updateModel != null)
        {
            <EditForm Model="@updateModel" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                 <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                     <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                         <DataAnnotationsValidator />
                        <ValidationSummary />
                        <SelectList Route="/api/selectlist/harvest" Label="Chọn đợt thu hoạch" @bind-Value="updateModel.HarvestId" />
                        <FluentTextInput Label="Tên sản phẩm" @bind-Value="updateModel.ProductName" MaxLength="200" />
                        <FluentTextInput Label="Mô tả" @bind-Value="updateModel.Description" MaxLength="500" />
                        <FluentTextInput Label="Hình thức chế biến" @bind-Value="updateModel.ProcessingType" MaxLength="50" />
                        <FluentNumberInput Label="Số lượng" @bind-Value="updateModel.Quantity" />
                        <FluentTextInput Label="Đơn vị" @bind-Value="updateModel.Unit" MaxLength="50" />
                        <FluentTextInput Label="Vị trí lưu kho" @bind-Value="updateModel.StorageLocation" MaxLength="200" />
                        <DateTimePicker Label="Hạn sử dụng" @bind-Value="expiryDate" />
                    </FluentStack>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <CurrencyNumberField Label="Giá vốn / đơn vị" @bind-Value="updateModel.CostPerUnit" />
                        <FluentNumberInput Label="Giá bán / đơn vị" @bind-Value="updateModel.SellingPrice" />
                        <CurrencyNumberField Label="Thành tiền" @bind-Value="updateModel.TotalValue" />
                        <SelectList Route="/api/enums/ProductStatus" Label="Trạng thái" @bind-Value="statusSelected" />
                        <FluentTextInput Label="Chứng nhận" @bind-Value="updateModel.Certification" MaxLength="200" />
                        <FluentTextInput Label="Ghi chú" @bind-Value="updateModel.Notes" MaxLength="500" />

                        <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/production/products/list" />
                    </FluentStack>
                </FluentStack>
              
            </EditForm>
        }
        else if (createModel != null)
        {
            <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                 <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                     <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <SelectList Route="/api/selectlist/harvest" Label="Chọn đợt thu hoạch" @bind-Value="createModel.HarvestId" />
                        <FluentTextInput Label="Tên sản phẩm" @bind-Value="createModel.ProductName" MaxLength="200" />
                        <FluentTextInput Label="Mô tả" @bind-Value="createModel.Description" MaxLength="500" />
                        <FluentTextInput Label="Hình thức chế biến" @bind-Value="createModel.ProcessingType" MaxLength="50" />
                        <FluentNumberInput Label="Số lượng" @bind-Value="createModel.Quantity" />
                        <FluentTextInput Label="Đơn vị" @bind-Value="createModel.Unit" MaxLength="50" />
                        <FluentTextInput Label="Vị trí lưu kho" @bind-Value="createModel.StorageLocation" MaxLength="200" />
                        <DateTimePicker Label="Hạn sử dụng" @bind-Value="expiryDate" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <CurrencyNumberField Label="Giá vốn / đơn vị" @bind-Value="createModel.CostPerUnit" />
                        <FluentNumberInput Label="Giá bán / đơn vị" @bind-Value="createModel.SellingPrice" />
                        <CurrencyNumberField Label="Thành tiền" @bind-Value="createModel.TotalValue" />
                        <SelectList Route="/api/enums/ProductStatus" Label="Trạng thái" @bind-Value="statusSelected" />
                        <FluentTextInput Label="Chứng nhận" @bind-Value="createModel.Certification" MaxLength="200" />
                        <FluentTextInput Label="Ghi chú" @bind-Value="createModel.Notes" MaxLength="500" />

                        <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/production/products/list" />
                    </FluentStack>
                </FluentStack>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? Id { get; set; }

    private UpdateProductModel? updateModel;
    private UpdateProductModel? orginalModel;
    private CreateProductModel? createModel;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    string? statusSelected;
    DateTime? expiryDate;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật sản phẩm";
            var result = await service.GetProductByIdAsync(Id, CancellationToken.None);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateProductModel(Id, result.Data);
                orginalModel = new UpdateProductModel(Id, result.Data);
                statusSelected = updateModel.Status?.ToIntString();
                expiryDate = updateModel.ExpiryDate?.ToLocalDateTime();
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Get Product"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Tạo mới sản phẩm";
            createModel = new CreateProductModel();
            statusSelected = ((int)InfoManager.Enum.SFMS.ProductStatus.Available).ToString();
        }

        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || orginalModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), InfoManager.Web.Models.AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        updateModel.Status = Enum.Parse<InfoManager.Enum.SFMS.ProductStatus>(statusSelected ?? "0");
        updateModel.ExpiryDate = expiryDate.ToUtcOffset();

        if (!updateModel.HasChanges(orginalModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        var result = await service.UpdateProductAsync(Id, updateModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Sản phẩm"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        createModel.Status = Enum.Parse<InfoManager.Enum.SFMS.ProductStatus>(statusSelected ?? "0");
        createModel.ExpiryDate = expiryDate.ToUtcOffset();

        var result = await service.CreateProductAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Sản phẩm"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
}