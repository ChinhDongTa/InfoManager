@page "/sfms/production/yield/details/{Id}"
@inject IYieldService service
@inject NavigationManager navigationManager

<PageHeader Title="Chi tiết phân tích năng suất" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        @if (yield != null)
        {
            <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <DetailItem Label="Mã lần trồng" Value="@yield.PlantingCode" />
                    <DetailItem Label="Cây trồng" Value="@yield.CropName" />
                    <DetailItem Label="Mã đợt thu hoạch" Value="@yield.HarvestId" />
                    <DetailItem Label="Ngày thu hoạch" Value="@(yield.HarvestDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")" />
                    <DetailItem Label="Sản lượng thực tế" Value="@FormatNumber.FormatDecimal(yield.ActualYield)" />
                    <DetailItem Label="Sản lượng kỳ vọng" Value="@FormatNumber.FormatDecimal(yield.ExpectedYield)" />
                    <DetailItem Label="Đơn vị" Value="@yield.Unit" />
                    <DetailItem Label="Năng suất / hecta" Value="@FormatNumber.FormatDecimal(yield.YieldPerHectare)" />
                    <DetailItem Label="Điểm chất lượng (%)" Value="@FormatNumber.FormatDecimal(yield.QualityRating)" />
                    <DetailItem Label="Tỷ lệ hao hụt (%)" Value="@FormatNumber.FormatDecimal(yield.WastePercentage)" />
                    <DetailItem Label="Chênh lệch so với kỳ vọng (%)" Value="@FormatNumber.FormatDecimal(yield.YieldVariance)" />
                </FluentStack>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <DetailItem Label="Số ngày sinh trưởng" Value="@(yield.GrowthDays?.ToString() ?? "-")" />
                    <DetailItem Label="Chi phí sản xuất" Value="@FormatNumber.FormatDecimal(yield.ProductionCost)" />
                    <DetailItem Label="Doanh thu" Value="@FormatNumber.FormatDecimal(yield.Revenue)" />
                    <DetailItem Label="Lợi nhuận" Value="@FormatNumber.FormatDecimal(yield.Profit)" />
                    <DetailItem Label="ROI (%)" Value="@FormatNumber.FormatDecimal(yield.ROI)" />
                    <DetailItem Label="Yếu tố ảnh hưởng" Value="@yield.AffectingFactors" />
                    <DetailItem Label="Phân tích" Value="@yield.Analysis" />
                    <DetailItem Label="Khuyến nghị vụ sau" Value="@yield.Recommendations" />
                    <DetailItem Label="Ngày tạo" Value="@yield.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" />
                </FluentStack>
            </FluentStack>
            <EntityActions EntityId="@Id" Folder="/sfms/production/yield" OnDeleteClick="DeleteHandler" />
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    YieldDto? yield;
    Alert? alertComponent;
    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetYieldByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                yield = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(
                    ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Yield"),
                    AlertType.Error,
                    Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void DeleteHandler()
    {
        alertComponent?.AddAlert("Not support", AlertType.Info, 5000);
    }
}