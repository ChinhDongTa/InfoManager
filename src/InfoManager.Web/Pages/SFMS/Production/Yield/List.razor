@page "/sfms/production/yield/list"
@inject IYieldService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách năng suất" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/production/yield/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="YieldSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="string" Title="Mã lần trồng" Property="@(x => x.PlantingCode)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="string" Title="Cây trồng" Property="@(x => x.CropName)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="decimal" Title="Sản lượng thực tế" Property="@(x => x.ActualYield)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="decimal?" Title="Sản lượng kỳ vọng" Property="@(x => x.ExpectedYield)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="string" Title="Đơn vị" Property="@(x => x.Unit)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="decimal" Title="Năng suất / ha" Property="@(x => x.YieldPerHectare)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="decimal?" Title="Chênh lệch (%)" Property="@(x => x.YieldVariance)" />
            <PropertyColumn TGridItem="YieldSummaryDto" TProp="decimal?" Title="Lợi nhuận" Property="@(x => x.Profit)" />
            <TemplateColumn TGridItem="YieldSummaryDto" Context="item" Title="Actions" Class="col-actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<YieldSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetYieldsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Yields"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetYieldsAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Yields"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/production/yield/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/production/yield/update/{id}");
    }
}