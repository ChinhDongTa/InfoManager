@page "/sfms/production/yields/update/{Id}"
@page "/sfms/production/yields/create/"
@inject IYieldService service

<PageHeader Title="Quản lý năng suất" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentLabel Typo="Typography.H4">
            @title
        </FluentLabel>
        @if (updateModel != null)
        {
            <EditForm Model="@updateModel" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <SelectList Route="/api/selectlist/cropplanting" Label="Chọn lần trồng" @bind-Value="updateModel.CropPlantingId" />
                        <SelectList Route="/api/selectlist/harvest" Label="Chọn đợt thu hoạch" @bind-Value="updateModel.HarvestId" />
                        <FluentNumberInput Label="Sản lượng thực tế" @bind-Value="updateModel.ActualYield" />
                        <FluentNumberInput Label="Sản lượng kỳ vọng" @bind-Value="updateModel.ExpectedYield" />
                        <FluentTextInput Label="Đơn vị" @bind-Value="updateModel.Unit" MaxLength="50" />
                        <FluentNumberInput Label="Năng suất / hecta" @bind-Value="updateModel.YieldPerHectare" />
                        <FluentNumberInput Label="Điểm chất lượng (%)" @bind-Value="updateModel.QualityRating" />
                        <FluentNumberInput Label="Tỷ lệ hao hụt (%)" @bind-Value="updateModel.WastePercentage" />
                        <FluentNumberInput Label="Chênh lệch (%)" @bind-Value="updateModel.YieldVariance" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <FluentNumberInput Label="Số ngày sinh trưởng" @bind-Value="updateModel.GrowthDays" />
                        <CurrencyNumberField Label="Chi phí sản xuất" @bind-Value="updateModel.ProductionCost" />
                        <CurrencyNumberField Label="Doanh thu" @bind-Value="updateModel.Revenue" />
                        <CurrencyNumberField Label="Lợi nhuận" @bind-Value="updateModel.Profit" />
                        <FluentNumberInput Label="ROI (%)" @bind-Value="updateModel.ROI" />
                        <FluentTextInput Label="Yếu tố ảnh hưởng" @bind-Value="updateModel.AffectingFactors" MaxLength="1000" />
                        <FluentTextInput Label="Phân tích" @bind-Value="updateModel.Analysis" MaxLength="1000" />
                        <FluentTextInput Label="Khuyến nghị vụ sau" @bind-Value="updateModel.Recommendations" MaxLength="1000" />
                    </FluentStack>
                </FluentStack>
                <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/production/yields/list" />
            </EditForm>
        }
        else if (createModel != null)
        {
            <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <SelectList Route="/api/selectlist/cropplanting" Label="Chọn lần trồng" @bind-Value="createModel.CropPlantingId" />
                        <SelectList Route="/api/selectlist/harvest" Label="Chọn đợt thu hoạch" @bind-Value="createModel.HarvestId" />
                        <FluentNumberInput Label="Sản lượng thực tế" @bind-Value="createModel.ActualYield" />
                        <FluentNumberInput Label="Sản lượng kỳ vọng" @bind-Value="createModel.ExpectedYield" />
                        <FluentTextInput Label="Đơn vị" @bind-Value="createModel.Unit" MaxLength="50" />
                        <FluentNumberInput Label="Năng suất / hecta" @bind-Value="createModel.YieldPerHectare" />
                        <FluentNumberInput Label="Điểm chất lượng (%)" @bind-Value="createModel.QualityRating" />
                        <FluentNumberInput Label="Tỷ lệ hao hụt (%)" @bind-Value="createModel.WastePercentage" />
                        <FluentNumberInput Label="Chênh lệch (%)" @bind-Value="createModel.YieldVariance" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <FluentNumberInput Label="Số ngày sinh trưởng" @bind-Value="createModel.GrowthDays" />
                        <CurrencyNumberField Label="Chi phí sản xuất" @bind-Value="createModel.ProductionCost" />
                        <CurrencyNumberField Label="Doanh thu" @bind-Value="createModel.Revenue" />
                        <CurrencyNumberField Label="Lợi nhuận" @bind-Value="createModel.Profit" />
                        <FluentNumberInput Label="ROI (%)" @bind-Value="createModel.ROI" />
                        <FluentTextInput Label="Yếu tố ảnh hưởng" @bind-Value="createModel.AffectingFactors" MaxLength="1000" />
                        <FluentTextInput Label="Phân tích" @bind-Value="createModel.Analysis" MaxLength="1000" />
                        <FluentTextInput Label="Khuyến nghị vụ sau" @bind-Value="createModel.Recommendations" MaxLength="1000" />
                    </FluentStack>
                </FluentStack>
                <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/production/yields/list" />
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? Id { get; set; }

    private UpdateYieldModel? updateModel;
    private UpdateYieldModel? orginalModel;
    private CreateYieldModel? createModel;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật năng suất";
            var result = await service.GetYieldByIdAsync(Id, CancellationToken.None);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateYieldModel(Id, result.Data);
                orginalModel = new UpdateYieldModel(Id, result.Data);
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Get Yield"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Tạo mới năng suất";
            createModel = new CreateYieldModel();
        }

        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || orginalModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), InfoManager.Web.Models.AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        if (!updateModel.HasChanges(orginalModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        var result = await service.UpdateYieldAsync(Id, updateModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Năng suất"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        var result = await service.CreateYieldAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Năng suất"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
}