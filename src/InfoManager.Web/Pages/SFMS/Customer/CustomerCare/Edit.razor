@page "/sfms/customers/customer-care/update/{Id}"
@page "/sfms/customers/customer-care/create/"
@inject ICustomerService server

<PageHeader Title="Quản lý chăm sóc khách hàng" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentLabel Typo="Typography.H4">
            @title
        </FluentLabel>
        @if (updateModel != null)
        {
            <EditForm Model="@updateModel" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <SelectList Route="/api/enums/CustomerCareType" Label="Loại chăm sóc" @bind-Value="careTypeSelected" />
                        <FluentTextField Label="Tiêu đề chăm sóc" @bind-Value="updateModel.Subject" />
                        <FluentTextField Label="Nội dung" @bind-Value="updateModel.Content" />
                        <DateTimePicker Label="Ngày chăm sóc" @bind-Value="careDate" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <DateTimePicker Label="Ngày theo dõi tiếp theo" @bind-Value="nextFollowUpDate" />
                        <SelectList Route="/api/enums/CustomerCareStatus" Label="Trạng thái chăm sóc" @bind-Value="statusSelected" />
                        <FluentTextField Label="Người xử lý" @bind-Value="updateModel.HandledBy" />
                        <FluentTextField Label="Kết quả" @bind-Value="updateModel.Result" />

                        <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/customers/customer-care/list" />
                    </FluentStack>
                </FluentStack>
            </EditForm>
        }
        else if (createModel != null)
        {
            <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <SelectList Route="/api/selectlist/customer" Label="Chọn khách hàng" @bind-Value="createModel.CustomerId" />
                        <SelectList Route="/api/selectlist/farm" Label="Chọn nông trại" @bind-Value="createModel.FarmId" />
                        <FluentTextField Label="Tiêu đề chăm sóc" @bind-Value="createModel.Subject" />
                        <SelectList Route="/api/enums/CustomerCareType" Label="Loại chăm sóc" @bind-Value="careTypeSelected" />
                        <FluentTextField Label="Nội dung" @bind-Value="createModel.Content" />
                        <DateTimePicker Label="Ngày chăm sóc" @bind-Value="careDate" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <DateTimePicker Label="Ngày theo dõi tiếp theo" @bind-Value="nextFollowUpDate" />
                        <SelectList Route="/api/enums/CustomerCareStatus" Label="Trạng thái chăm sóc" @bind-Value="statusSelected" />
                        <FluentTextField Label="Người xử lý" @bind-Value="createModel.HandledBy" />
                        <FluentTextField Label="Kết quả" @bind-Value="createModel.Result" />

                        <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/customers/customer-care/list" />
                    </FluentStack>
                </FluentStack>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? Id { get; set; }

    private UpdateCustomerCareModel? updateModel;
    private UpdateCustomerCareModel? orginalModel;
    private CreateCustomerCareModel? createModel;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    string? careTypeSelected;
    string? statusSelected;
    DateTime? careDate;
    DateTime? nextFollowUpDate;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật chăm sóc khách hàng";
            var result = await server.GetCustomerCareByIdAsync(Id, CancellationToken.None);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateCustomerCareModel(Id, result.Data);
                orginalModel = new UpdateCustomerCareModel(Id, result.Data);
                careTypeSelected = updateModel.CareType?.ToIntString();
                statusSelected = updateModel.Status?.ToIntString();
                careDate = updateModel.CareDate?.ToLocalDateTime();
                nextFollowUpDate = updateModel.NextFollowUpDate?.ToLocalDateTime();
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Get Customer Care"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Tạo mới chăm sóc khách hàng";
            createModel = new CreateCustomerCareModel();
            careDate = DateTime.UtcNow;
        }

        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || orginalModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), InfoManager.Web.Models.AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        updateModel.CareType = Enum.Parse<InfoManager.Enum.SFMS.CustomerCareType>(careTypeSelected ?? "0");
        updateModel.Status = Enum.Parse<InfoManager.Enum.SFMS.CustomerCareStatus>(statusSelected ?? "0");
        updateModel.CareDate = careDate.ToUtcOffset();
        updateModel.NextFollowUpDate = nextFollowUpDate.ToUtcOffset();

        if (!updateModel.HasChanges(orginalModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        var result = await server.UpdateCustomerCareAsync(Id, updateModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Chăm sóc khách hàng"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        createModel.CareType = Enum.Parse<InfoManager.Enum.SFMS.CustomerCareType>(careTypeSelected ?? "0");
        createModel.Status = Enum.Parse<InfoManager.Enum.SFMS.CustomerCareStatus>(statusSelected ?? "0");
        createModel.CareDate = careDate.ToUtcOffset()!.Value;
        createModel.NextFollowUpDate = nextFollowUpDate.ToUtcOffset();

        var result = await server.CreateCustomerCareAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Chăm sóc khách hàng"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
}