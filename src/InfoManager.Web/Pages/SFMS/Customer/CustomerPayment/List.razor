@page "/sfms/customers/customer-payment/list"
@inject ICustomerService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách thanh toán khách hàng" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/customers/customer-payment/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="CustomerPaymentSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="CustomerPaymentSummaryDto" TProp="string" Title="Khách hàng" Property="@(x => x.CustomerName)" />
            <PropertyColumn TGridItem="CustomerPaymentSummaryDto" TProp="decimal" Title="Số tiền" Property="@(x => x.Amount)" />
            <PropertyColumn TGridItem="CustomerPaymentSummaryDto" TProp="DateTimeOffset" Title="Ngày thanh toán" Property="@(x => x.PaymentDate)" />
            <PropertyColumn TGridItem="CustomerPaymentSummaryDto" TProp="string" Title="Phương thức" Property="@(x => x.PaymentMethod)" />
            <PropertyColumn TGridItem="CustomerPaymentSummaryDto" TProp="string" Title="Trạng thái" Property="@(x => x.PaymentStatusName)" />
            <TemplateColumn TGridItem="CustomerPaymentSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<CustomerPaymentSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetCustomerPaymentsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Customer payments"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetCustomerPaymentsAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Customer payments"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/customers/customer-payment/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/customers/customer-payment/update/{id}");
    }
}