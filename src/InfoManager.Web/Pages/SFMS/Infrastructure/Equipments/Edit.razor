@page "/sfms/infrastructure/equipments/update/{Id}"
@page "/sfms/infrastructure/equipments/create/"
@inject IEquipmentService equipmentService

<PageHeader Title="Quản lý máy móc thiết bị" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentLabel Typo="Typography.H4">
            @title
        </FluentLabel>
        @if (updateModel != null)
        {
            <EditForm Model="@updateModel" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <FluentTextField Label="Tên thiết bị" @bind-Value="updateModel.Name" />
                    <SelectList Route="/api/enums/EquipmentType" Label="Loại thiết bị" @bind-Value="equipmentTypeSelected" />
                    <SelectList Route="/api/selectlist/farm" Label="Chọn nông trại" @bind-Value="updateModel.FarmId" />
                    <FluentTextField Label="Nhà sản xuất" @bind-Value="updateModel.Manufacturer" />
                    <FluentTextField Label="Số model" @bind-Value="updateModel.Model" />
                    <FluentTextField Label="Số serial" @bind-Value="updateModel.SerialNumber" />
                    <FluentNumberField Label="Công suất (HP)" @bind-Value="updateModel.PowerRating" />
                    <FluentTextField Label="Thông số kỹ thuật / dung tích" @bind-Value="updateModel.Specifications" />
                    <DateTimePicker Label="Ngày mua" @bind-Value="purchaseDate" />
                    <FluentNumberField Label="Giá mua" @bind-Value="updateModel.PurchaseCost" />
                    <FluentNumberField Label="Giá trị hiện tại" @bind-Value="updateModel.CurrentValue" />
                    <SelectList Route="/api/enums/EquipmentStatus" Label="Trạng thái thiết bị" @bind-Value="statusSelected" />
                    <FluentNumberField Label="Số giờ vận hành" @bind-Value="updateModel.OperatingHours" />
                    <DateTimePicker Label="Ngày bảo trì gần nhất" @bind-Value="lastMaintenanceDate" />
                    <DateTimePicker Label="Ngày bảo trì kế tiếp" @bind-Value="nextMaintenanceDate" />
                    <FluentTextField Label="Vị trí lưu trữ" @bind-Value="updateModel.StorageLocation" />
                    <FluentTextField Label="Ghi chú" @bind-Value="updateModel.Notes" />

                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/infrastructure/equipments/list" />
                </FluentStack>
            </EditForm>
        }
        else if (createModel != null)
        {
            <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <FluentTextField Label="Tên thiết bị" @bind-Value="createModel.Name" />
                    <SelectList Route="/api/enums/EquipmentType" Label="Loại thiết bị" @bind-Value="equipmentTypeSelected" />
                    <SelectList Route="/api/selectlist/farm" Label="Chọn nông trại" @bind-Value="createModel.FarmId" />
                    <FluentTextField Label="Nhà sản xuất" @bind-Value="createModel.Manufacturer" />
                    <FluentTextField Label="Số model" @bind-Value="createModel.Model" />
                    <FluentTextField Label="Số serial" @bind-Value="createModel.SerialNumber" />
                    <FluentNumberField Label="Công suất (HP)" @bind-Value="createModel.PowerRating" />
                    <FluentTextField Label="Thông số kỹ thuật / dung tích" @bind-Value="createModel.Specifications" />
                    <DateTimePicker Label="Ngày mua" @bind-Value="purchaseDate" />
                    <FluentNumberField Label="Giá mua" @bind-Value="createModel.PurchaseCost" />
                    <FluentNumberField Label="Giá trị hiện tại" @bind-Value="createModel.CurrentValue" />
                    <SelectList Route="/api/enums/EquipmentStatus" Label="Trạng thái thiết bị" @bind-Value="statusSelected" />
                    <FluentNumberField Label="Số giờ vận hành" @bind-Value="createModel.OperatingHours" />
                    <DateTimePicker Label="Ngày bảo trì gần nhất" @bind-Value="lastMaintenanceDate" />
                    <DateTimePicker Label="Ngày bảo trì kế tiếp" @bind-Value="nextMaintenanceDate" />
                    <FluentTextField Label="Vị trí lưu trữ" @bind-Value="createModel.StorageLocation" />
                    <FluentTextField Label="Ghi chú" @bind-Value="createModel.Notes" />

                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/infrastructure/equipments/list" />
                </FluentStack>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? Id { get; set; }

    private UpdateEquipmentModel? updateModel;
    private UpdateEquipmentModel? orginalModel;
    private CreateEquipmentModel? createModel;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    string? equipmentTypeSelected;
    string? statusSelected;
    DateTime? purchaseDate;
    DateTime? lastMaintenanceDate;
    DateTime? nextMaintenanceDate;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật máy móc thiết bị";
            var result = await equipmentService.GetEquipmentByIdAsync(Id, CancellationToken.None);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateEquipmentModel(Id, result.Data);
                orginalModel = new UpdateEquipmentModel(Id, result.Data);

                equipmentTypeSelected = updateModel.EquipmentType?.ToIntString();
                statusSelected = updateModel.Status?.ToIntString();
                purchaseDate = updateModel.PurchaseDate?.ToLocalDateTime();
                lastMaintenanceDate = updateModel.LastMaintenanceDate?.ToLocalDateTime();
                nextMaintenanceDate = updateModel.NextMaintenanceDate?.ToLocalDateTime();
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Get Equipment"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Tạo mới máy móc thiết bị";
            createModel = new CreateEquipmentModel();
        }

        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || orginalModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), InfoManager.Web.Models.AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        updateModel.EquipmentType = Enum.Parse<InfoManager.Enum.SFMS.EquipmentType>(equipmentTypeSelected ?? "0");
        updateModel.Status = Enum.Parse<InfoManager.Enum.SFMS.EquipmentStatus>(statusSelected ?? "0");
        updateModel.PurchaseDate = purchaseDate.ToUtcOffset();
        updateModel.LastMaintenanceDate = lastMaintenanceDate.ToUtcOffset();
        updateModel.NextMaintenanceDate = nextMaintenanceDate.ToUtcOffset();

        if (!updateModel.HasChanges(orginalModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        var result = await equipmentService.UpdateEquipmentAsync(Id, updateModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Máy móc thiết bị"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        createModel.EquipmentType = Enum.Parse<InfoManager.Enum.SFMS.EquipmentType>(equipmentTypeSelected ?? "0");
        createModel.Status = Enum.Parse<InfoManager.Enum.SFMS.EquipmentStatus>(statusSelected ?? "0");
        createModel.PurchaseDate = purchaseDate.ToUtcOffset();
        createModel.LastMaintenanceDate = lastMaintenanceDate.ToUtcOffset();
        createModel.NextMaintenanceDate = nextMaintenanceDate.ToUtcOffset();

        var result = await equipmentService.CreateEquipmentAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Máy móc thiết bị"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
}