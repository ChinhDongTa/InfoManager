@page "/sfms/Infrastructure/farms/list"
@inject IFarmService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách trang trại" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/Infrastructure/farms/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="FarmSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="FarmSummaryDto" TProp="string" Title="Tên" Property="@(x => x.Name)" />
            <PropertyColumn TGridItem="FarmSummaryDto" TProp="string" Title="Trạng thái" Property="@(x => x.StatusName)" />
            <PropertyColumn TGridItem="FarmSummaryDto" TProp="decimal" Title="TotalArea" Property="@(x => x.TotalArea)" />
            <PropertyColumn TGridItem="FarmSummaryDto" TProp="decimal" Title="CultivableArea" Property="@(x => x.CultivableArea)" />
            <PropertyColumn TGridItem="FarmSummaryDto" TProp="string" Title="Location" Property="@(x => x.Location)" />
            <TemplateColumn TGridItem="FarmSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<FarmSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetFarmsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Farms"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;
        //StateHasChanged();

        var result = await service.GetFarmsAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
            //items = paginatedList.Items.AsQueryable();
            //Console.WriteLine($"Total: {paginatedList.TotalCount} families.");
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Farms"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/Infrastructure/farms/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/infrastructure/farms/update/{id}");
    }
}
