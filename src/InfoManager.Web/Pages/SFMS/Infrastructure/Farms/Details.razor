@page "/sfms/Infrastructure/farms/details/{Id}"
@inject IFarmService service

<PageHeader Title="Thông tin chi tiết nông trại" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="max-width:600px; margin: 20px auto;">
            <DetailItem Label="Tên nông trại" Value="@dto?.Name" />
            <DetailItem Label="Mô tả" Value="@dto?.Description" />
            <DetailItem Label="Tổng diện tích" Value="@(FormatNumber.FormatDecimal(dto?.TotalArea))" />
            <DetailItem Label="Diện tích canh tác" Value="@(FormatNumber.FormatDecimal(dto?.CultivableArea))" />
            <DetailItem Label="Vị trí" Value="@dto?.Location" />
            <DetailItem Label="Vĩ độ" Value="@(FormatNumber.FormatDecimal(dto?.Latitude))" />
            <DetailItem Label="Kinh độ" Value="@(FormatNumber.FormatDecimal(dto?.Longitude))" />
            <DetailItem Label="Chủ hộ">
                @if (!string.IsNullOrWhiteSpace(dto?.FarmerId))
                {
                    <a href="/sfms/Infrastructure/farmers/details/@dto.FarmerId">@(dto?.FarmerName ?? dto?.FarmerId)</a>
                }
                else
                {
                    <text>-</text>
                }
            </DetailItem>
            <DetailItem Label="Số giấy phép" Value="@dto?.LicenseNumber" />
            <DetailItem Label="Trạng thái" Value="@dto?.StatusName" />
            <DetailItem Label="Ngày thành lập" Value="@dto?.EstablishedDate?.ToString("dd/MM/yyyy")" />
            <DetailItem Label="Ngày tạo" Value="@dto?.Created.ToString("dd/MM/yyyy HH:mm")" />
            <EntityActions EntityId="@Id" Folder="/sfms/Infrastructure/farms" OnDeleteClick="DeleteHandler" />
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }

    bool isLoading = false;
    FarmDto? dto;
    Alert? alertComponent;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        if (string.IsNullOrEmpty(Id))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorRequired("Id"), AlertType.Error, Models.Constants.DismissAlertAfter5Seconds);
            isLoading = false;
            return;
        }

        var result = await service.GetFarmByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("Farm"), AlertType.Error, Models.Constants.DismissAlertAfter5Seconds);
        }

        isLoading = false;
    }

    private void DeleteHandler()
    {
        alertComponent?.AddAlert("Not support !");
    }
}