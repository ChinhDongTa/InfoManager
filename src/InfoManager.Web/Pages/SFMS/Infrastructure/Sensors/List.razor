@page "/sfms/Infrastructure/sensors/list"
@inject ISensorService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách cảm biến" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/Infrastructure/sensors/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="SensorSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="string" Title="Tên" Property="@(x => x.Name)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="string" Title="Loại cảm biến" Property="@(x => x.SensorTypeName)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="string" Title="Thửa ruộng" Property="@(x => x.FieldName)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="string" Title="Thiết bị" Property="@(x => x.DeviceName)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="string" Title="Trạng thái" Property="@(x => x.StatusName)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="decimal?" Title="Pin" Property="@(x => x.BatteryLevel)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="decimal?" Title="Tín hiệu" Property="@(x => x.SignalStrength)" />
            <PropertyColumn TGridItem="SensorSummaryDto" TProp="DateTimeOffset?" Title="Đọc lần cuối" Property="@(x => x.LastReadingTime)" />
            <TemplateColumn TGridItem="SensorSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<SensorSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetSensorsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Sensors"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetSensorsAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Sensors"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/Infrastructure/sensors/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/infrastructure/sensors/update/{id}");
    }
}