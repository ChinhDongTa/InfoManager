@page "/sfms/Infrastructure/farmers/details/{Id}"
@inject IFarmerService service

<PageHeader Title="Thông tin chi tiết nông dân" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="max-width:600px; margin: 20px auto;">
            <DetailItem Label="Mã chủ hộ" Value="@dto?.FarmerCode" />
            <DetailItem Label="Họ tên" Value="@dto?.FullName" />
            <DetailItem Label="CCCD" Value="@dto?.IdentityNumber" />
            <DetailItem Label="Email">
                <a href="mailto:@dto?.Email">@dto?.Email</a>
            </DetailItem>
            <DetailItem Label="Điện thoại" Value="@dto?.Phone" />
            <DetailItem Label="Ghi chú" Value="@dto?.Notes" />
            <EntityActions EntityId="@Id" Folder="/sfms/Infrastructure/farmers" OnDeleteClick="DeleteHandler" />
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>
@code {
    [Parameter]
    public required string Id{ get; set; }
    bool isLoading = false;
    FarmerDto? dto;
    Alert? alertComponent;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        if (string.IsNullOrEmpty(Id))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorRequired("Id"), AlertType.Error, Models.Constants.DismissAlertAfter5Seconds);
            isLoading = false;
            return;
        }
        var result = await service.GetFarmerByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("Farmer"),AlertType.Error,Models.Constants.DismissAlertAfter5Seconds);
        isLoading = false;
    }

    private void DeleteHandler()
    {
        alertComponent?.AddAlert("Not support !");
    }
}