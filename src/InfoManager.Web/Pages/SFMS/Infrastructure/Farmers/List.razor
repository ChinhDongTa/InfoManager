@page "/sfms/Infrastructure/farmers/list"
@inject IFarmerService service
@inject NavigationManager navigationManager

<PageHeader Title="Danh sách nông dân/Chủ hộ" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/Infrastructure/farmers/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="FarmerSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
           <PropertyColumn TGridItem="FarmerSummaryDto" TProp="string" Title="Mã chủ hộ" Property="@(x=>x.FarmerCode)" />
            <PropertyColumn TGridItem="FarmerSummaryDto" TProp="string" Title="Họ và tên" Property="@(x => x.FullName)" />
            <PropertyColumn TGridItem="FarmerSummaryDto" TProp="string" Title="Điện thoại" Property="@(x => x.Phone)" />
            <PropertyColumn TGridItem="FarmerSummaryDto" TProp="string" Title="Email" Property="@(x => x.Email)" />
            <TemplateColumn TGridItem="FarmerSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<FarmerSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetFarmersAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Farmer"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;
        //StateHasChanged();

        var result = await service.GetFarmersAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
            //items = paginatedList.Items.AsQueryable();
            //Console.WriteLine($"Total: {paginatedList.TotalCount} families.");
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Farmer"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/Infrastructure/farmers/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/infrastructure/farmers/update/{id}"); 
    }
}
