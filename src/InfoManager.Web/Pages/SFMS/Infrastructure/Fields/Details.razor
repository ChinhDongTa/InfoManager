@page "/sfms/Infrastructure/fields/details/{Id}"
@inject IFieldService service
@using System.Globalization

<PageHeader Title="Thông tin chi tiết thửa đất" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="max-width:600px; margin: 20px auto;">
            <DetailItem Label="Tên thửa đất" Value="@dto?.Name" />
            <DetailItem Label="Mô tả" Value="@dto?.Description" />
            <DetailItem Label="Diện tích" Value="@(FormatNumber.FormatDecimal(dto?.Area))" />
            <DetailItem Label="Nông trại">
                @if (!string.IsNullOrWhiteSpace(dto?.FarmId))
                {
                    <a href="/sfms/Infrastructure/farms/details/@dto.FarmId">@(dto?.FarmName ?? dto?.FarmId)</a>
                }
                else
                {
                    <text>-</text>
                }
            </DetailItem>
            <DetailItem Label="Loại đất" Value="@dto?.SoilType" />
            <DetailItem Label="Tình trạng đất" Value="@dto?.SoilConditionName" />
            <DetailItem Label="Độ cao" Value="@dto?.Elevation?.ToString()" />
            <DetailItem Label="Vĩ độ" Value="@dto?.Latitude?.ToString()" />
            <DetailItem Label="Kinh độ" Value="@dto?.Longitude?.ToString()" />
            <DetailItem Label="Trạng thái" Value="@dto?.StatusName" />
            <DetailItem Label="Ngày làm đất gần nhất" Value="@dto?.LastPreparationDate?.ToString("dd/MM/yyyy")" />
            <DetailItem Label="Điều kiện thoát nước" Value="@dto?.DrainageCondition" />
            <DetailItem Label="Có hệ thống tưới" Value="@(dto?.HasIrrigation == true ? "Có" : "Không")" />
            <DetailItem Label="Số lần trồng cây" Value="@dto?.CropPlantingCount.ToString()" />
            <DetailItem Label="Số cảm biến" Value="@dto?.SensorCount.ToString()" />
            <DetailItem Label="Số lần phân tích đất" Value="@dto?.SoilAnalysisCount.ToString()" />
            <DetailItem Label="Số công việc" Value="@dto?.TaskCount.ToString()" />
            <DetailItem Label="Ngày tạo" Value="@dto?.Created.ToString("dd/MM/yyyy HH:mm")" />

            <DetailItem Label="Bản đồ vị trí">
                @if (HasCoordinates)
                {
                    <div>
                        <div style="width:100%; height:320px; border-radius:8px; overflow:hidden; border:1px solid var(--neutral-stroke-rest);">
                            <iframe title="Field location map"
                                    src="@MapEmbedUrl"
                                    width="100%"
                                    height="320"
                                    style="border:0;"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                        <a href="@MapExternalUrl" target="_blank" rel="noopener noreferrer">Mở bản đồ lớn</a>
                    </div>
                }
                else
                {
                    <text>Chưa có tọa độ để hiển thị bản đồ.</text>
                }
            </DetailItem>

            <EntityActions EntityId="@Id" Folder="/sfms/Infrastructure/fields" OnDeleteClick="DeleteHandler" />
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }

    bool isLoading = false;
    FieldDto? dto;
    Alert? alertComponent;

    bool HasCoordinates => dto?.Latitude is not null && dto?.Longitude is not null;

    string MapEmbedUrl
    {
        get
        {
            if (!HasCoordinates) return string.Empty;

            var lat = dto!.Latitude!.Value;
            var lng = dto.Longitude!.Value;
            var delta = 0.008m;

            var minLng = (lng - delta).ToString(CultureInfo.InvariantCulture);
            var minLat = (lat - delta).ToString(CultureInfo.InvariantCulture);
            var maxLng = (lng + delta).ToString(CultureInfo.InvariantCulture);
            var maxLat = (lat + delta).ToString(CultureInfo.InvariantCulture);
            var latText = lat.ToString(CultureInfo.InvariantCulture);
            var lngText = lng.ToString(CultureInfo.InvariantCulture);

            return $"https://www.openstreetmap.org/export/embed.html?bbox={minLng}%2C{minLat}%2C{maxLng}%2C{maxLat}&layer=mapnik&marker={latText}%2C{lngText}";
        }
    }

    string MapExternalUrl
    {
        get
        {
            if (!HasCoordinates) return "#";

            var latText = dto!.Latitude!.Value.ToString(CultureInfo.InvariantCulture);
            var lngText = dto.Longitude!.Value.ToString(CultureInfo.InvariantCulture);
            return $"https://www.openstreetmap.org/?mlat={latText}&mlon={lngText}#map=16/{latText}/{lngText}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        if (string.IsNullOrEmpty(Id))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorRequired("Id"), AlertType.Error, Models.Constants.DismissAlertAfter5Seconds);
            isLoading = false;
            return;
        }

        var result = await service.GetFieldByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("Field"), AlertType.Error, Models.Constants.DismissAlertAfter5Seconds);
        }

        isLoading = false;
    }

    private void DeleteHandler()
    {
        alertComponent?.AddAlert("Not support !");
    }
}