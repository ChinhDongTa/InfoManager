@page "/sfms/infrastructure/fields/update/{Id}"
@page "/sfms/infrastructure/fields/create/"
@inject IFieldService fieldService

<PageHeader Title="Quản lý thửa đất" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentLabel Typo="Typography.H4">
            @title
        </FluentLabel>
        @if (updateModel != null)
        {
            <EditForm Model="@updateModel" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <FluentTextField Label="Tên thửa đất" @bind-Value="updateModel.Name" />
                        <FluentTextField Label="Mô tả" @bind-Value="updateModel.Description" />
                        <FluentNumberField Label="Diện tích" @bind-Value="updateModel.Area" />
                        <SelectList Route="/api/selectlist/farm" Label="Chọn nông trại" @bind-Value="updateModel.FarmId" />
                        <FluentTextField Label="Loại đất" @bind-Value="updateModel.SoilType" />
                        <SelectList Route="/api/enums/SoilCondition" Label="Tình trạng đất" @bind-Value="soilConditionSelected" />
                        <FluentNumberField Label="Độ cao" @bind-Value="updateModel.Elevation" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                        <FluentNumberField Label="Vĩ độ" @bind-Value="updateModel.Latitude" />
                        <FluentNumberField Label="Kinh độ" @bind-Value="updateModel.Longitude" />
                        <SelectList Route="/api/enums/FieldStatus" Label="Trạng thái thửa đất" @bind-Value="statusSelected" />
                        <DateTimePicker Label="Ngày làm đất gần nhất" @bind-Value="lastPreparationDate" />
                        <FluentTextField Label="Điều kiện thoát nước" @bind-Value="updateModel.DrainageCondition" />
                        <FluentCheckbox Label="Có hệ thống tưới" @bind-Value="hasIrrigation" />
                        <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/infrastructure/fields/list" />
                    </FluentStack>
                </FluentStack>
                
            </EditForm>
        }
        else if (createModel != null)
        {
            <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
            <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5" >
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <FluentTextField Label="Tên thửa đất" @bind-Value="createModel.Name" />
                    <FluentTextField Label="Mô tả" @bind-Value="createModel.Description" />
                    <FluentNumberField Label="Diện tích" @bind-Value="createModel.Area" />
                    <SelectList Route="/api/selectlist/farm" Label="Chọn nông trại" @bind-Value="createModel.FarmId" />
                    <FluentTextField Label="Loại đất" @bind-Value="createModel.SoilType" />
                    <SelectList Route="/api/enums/SoilCondition" Label="Tình trạng đất" @bind-Value="soilConditionSelected" />
                </FluentStack>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5" >
                    <FluentNumberField Label="Độ cao" @bind-Value="createModel.Elevation" />
                    <FluentNumberField Label="Vĩ độ" @bind-Value="createModel.Latitude" />
                    <FluentNumberField Label="Kinh độ" @bind-Value="createModel.Longitude" />
                    <SelectList Route="/api/enums/FieldStatus" Label="Trạng thái thửa đất" @bind-Value="statusSelected" />
                    <DateTimePicker Label="Ngày làm đất gần nhất" @bind-Value="lastPreparationDate" />
                    <FluentTextField Label="Điều kiện thoát nước" @bind-Value="createModel.DrainageCondition" />
                    <FluentCheckbox Label="Có hệ thống tưới" @bind-Value="createModel.HasIrrigation" />
                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/sfms/infrastructure/fields/list" />
                </FluentStack>
            </FluentStack>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? Id { get; set; }

    private UpdateFieldModel? updateModel;
    private UpdateFieldModel? orginalModel;
    private CreateFieldModel? createModel;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    string? soilConditionSelected;
    string? statusSelected;
    DateTime? lastPreparationDate;
    bool hasIrrigation;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật thửa đất";
            var result = await fieldService.GetFieldByIdAsync(Id, CancellationToken.None);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateFieldModel(Id, result.Data);
                orginalModel = new UpdateFieldModel(Id, result.Data);
                soilConditionSelected = updateModel.SoilCondition?.ToIntString();
                statusSelected = updateModel.Status?.ToIntString();
                lastPreparationDate = updateModel.LastPreparationDate?.ToLocalDateTime();
                hasIrrigation = updateModel.HasIrrigation ?? false;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Get Field"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Tạo mới thửa đất";
            createModel = new CreateFieldModel();
            statusSelected = ((int)InfoManager.Enum.SFMS.FieldStatus.Vacant).ToString();
        }

        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || orginalModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), InfoManager.Web.Models.AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        updateModel.SoilCondition = string.IsNullOrEmpty(soilConditionSelected)
            ? null
            : Enum.Parse<InfoManager.Enum.SFMS.SoilCondition>(soilConditionSelected);
        updateModel.Status = Enum.Parse<InfoManager.Enum.SFMS.FieldStatus>(statusSelected ?? "0");
        updateModel.LastPreparationDate = lastPreparationDate.ToUtcOffset();
        updateModel.HasIrrigation = hasIrrigation;

        if (!updateModel.HasChanges(orginalModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        var result = await fieldService.UpdateFieldAsync(Id, updateModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Thửa đất"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        createModel.SoilCondition = string.IsNullOrEmpty(soilConditionSelected)
            ? null
            : Enum.Parse<InfoManager.Enum.SFMS.SoilCondition>(soilConditionSelected);
        createModel.Status = Enum.Parse<InfoManager.Enum.SFMS.FieldStatus>(statusSelected ?? "0");
        createModel.LastPreparationDate = lastPreparationDate.ToUtcOffset();

        var result = await fieldService.CreateFieldAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Thửa đất"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
}