@page "/sfms/Infrastructure/fields/list"
@inject IFieldService service
@inject NavigationManager navigationManager
<PageHeader Title="Danh sách thửa ruộng" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/sfms/Infrastructure/fields/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="FieldSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="string" Title="Tên" Property="@(x => x.Name)" />
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="string" Title="Trang trại" Property="@(x => x.FarmName)" />
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="decimal" Title="Diện tích" Property="@(x => x.Area)" />
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="string" Title="Loại đất" Property="@(x => x.SoilType)" />
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="string" Title="Tình trạng đất" Property="@(x => x.SoilConditionName)" />
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="string" Title="Trạng thái" Property="@(x => x.StatusName)" />
            <PropertyColumn TGridItem="FieldSummaryDto" TProp="bool" Title="Có tưới" Property="@(x => x.HasIrrigation)" />
            <TemplateColumn TGridItem="FieldSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<FieldSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;

    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetFieldsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Fields"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;

        var result = await service.GetFieldsAsync(currentPage, pageSize);
        if (result.Success && result.Data != null)
        {
            paginatedList = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Fields"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/Infrastructure/fields/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/sfms/infrastructure/fields/update/{id}");
    }
}