@page "/account/InitData"
@using InfoManager.Shared.Dtos.Auths
@using InfoManager.Shared.Dtos.Families
@inject NavigationManager navigationManager
@inject IAuthService authService
@inject IFamilyService familyService

<PageHeader Title="Quản lý thành viên gia đình" />
<Alert @ref="alertComponent" />

<EditForm Model="@createModel" OnValidSubmit="@HandleValidSubmit">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <FluentTextField Label="Họ và tên" @bind-Value="createModel.FullName" Required />
        <DateTimePicker @bind-Value="@birthDate" WithTime="false" Label="Ngày sinh" />
        <SelectList Label="Giới tính" @bind-Value="@genderSelected" Route="api/enums/gender" />
        <FluentTextField Label="Mật khẩu" @bind-Value="createModel.Password" TextFieldType="TextFieldType.Password" Minlength="8" Required />
        <FluentTextField Label="Xác nhận mật khẩu" @bind-Value="confirmPassword" Minlength="8" TextFieldType="TextFieldType.Password" Required />
        <FluentTextField Label="Email" @bind-Value="createModel.Email" TextFieldType="TextFieldType.Email"  Required />
        <FluentTextField Label="Phone" @bind-Value="createModel.PhoneNumber" Maxlength="50" />
        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit">
            @if (IsSaving)
            {
                <span>Đang lưu...</span>
            }
            else
            {
                <span>Lưu</span>
            }                                   
        </FluentButton> 
    </FluentStack>
</EditForm>

@code {
    Alert? alertComponent;
    bool IsSaving = false;

    InitDataModel createModel = new InitDataModel();

    private DateTime? birthDate;
    string genderSelected = string.Empty;
    string? confirmPassword;

    private async Task HandleValidSubmit()
    {
        IsSaving = true;
        if (createModel.Password != confirmPassword)
        {
            alertComponent?.AddAlert("Mật khẩu và xác nhận mật khẩu không khớp", AlertType.Error, Constants.DismissAlertAfter5Seconds);
            IsSaving = false;
            return;
        }

        var registerResult = await authService.RegisterAsync(new RegisterRequest(createModel.Email, createModel.Password));
        if(!registerResult.Success)
        {
            IsSaving = false;
            alertComponent?.AddAlert(registerResult.ErrorMessage.ToLine(" | "), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            return;
        }

        createModel.BirthDate = birthDate?.ToDateOnly() ?? DateOnly.MinValue;
        createModel.Gender = Enum.Parse<Gender>(genderSelected);
        var initResult = await familyService.InitFamilyEventsForUserAsync(createModel.ToInitDataForUserRequest());
        if (!initResult.Success)
        {
            IsSaving = false;
            alertComponent?.AddAlert(initResult.ErrorMessage.ToLine(" | "), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            return;
        }
        else
        {
            alertComponent?.AddAlert(initResult.Data!.Message, AlertType.Success, Constants.DismissAlertAfter5Seconds);
        }
        IsSaving = false;
        await Task.Delay(5500);
        navigationManager.NavigateTo("/Families/list");
    }

    private class InitDataModel
    {
        public string FullName{ get; set; }
        public string Email { get; set; }
        public string Password { get; set; }
        public DateOnly BirthDate { get; set; }
        public Gender Gender { get; set; }
        public string? PhoneNumber { get; set; }

        public InitDataForUserRequest ToInitDataForUserRequest()
        {
            return new InitDataForUserRequest(FullName: FullName,
                Email: Email,
                BirthDate: BirthDate,
                Gender: Gender,
                PhoneNumber: PhoneNumber
            );
        }
    }
}