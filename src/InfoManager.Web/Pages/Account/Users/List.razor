@page "/account/users/list"
@using InfoManager.Shared.Dtos.Auths
@inject NavigationManager navigationManager
@inject IIdentityService IdentityService
<PageHeader Title="Danh sách user" Description="@des"/>
<Alert @ref="alert" />

<AuthorizeView Roles="admin">
    <Authorized>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="margin: 20px auto;">
            <FluentSearch @ref=fluentSearch
                          @bind-Value="@searchValue"
                          @bind-Value:after=HandleSearchInput
                          Placeholder="Search for email" />
            @if (items != null)
            {
                <FluentDataGrid Items="items" TGridItem="UserDto">
                    <PropertyColumn Property="@(item => item.UserNameOrEmail)" Sortable="true" />
                    <PropertyColumn Property="@(item => item.PhoneNumber)" Sortable="true" />
                    <PropertyColumn Property="@(item => item.Roles.ToLine(" | "))" Title="Roles" /> 
                    <TemplateColumn Context="item" Title="Thao tác" Align="Align.End">
                        <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                    </TemplateColumn>
                </FluentDataGrid>
            }
            else
            {
                <FluentLabel>
                    Không có user nào thỏa mãn điều kiện tìm kiếm !
                </FluentLabel>
            }
        </FluentStack>
       
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
        @* @{
            var identity = context.User.Identity as System.Security.Claims.ClaimsIdentity;
            var roleClaimType = identity?.RoleClaimType ?? "null";

            var roles = context.User.Claims
                .Where(c => c.Type == roleClaimType)   // chỉ lấy đúng theo RoleClaimType
                .Select(c => c.Value)
                .ToList();
        }

        <p>RoleClaimType hiện tại: <strong>@roleClaimType</strong></p>
        <p>Roles theo RoleClaimType: @(roles.Any() ? string.Join(", ", roles) : "Không có")</p>

        <hr />
        <p>Tất cả claims:</p>
        @foreach (var c in context.User.Claims)
        {
            <div>@c.Type → @c.Value</div>
        } *@
    </NotAuthorized>
</AuthorizeView>

@code {
    FluentSearch? fluentSearch;
    string? searchValue;
    private IQueryable<UserDto>? items;
    private Alert? alert;
    string? des = null;
    private async Task HandleSearchInput()
    {
        if (string.IsNullOrWhiteSpace(searchValue))
        {
            searchValue = string.Empty;
            items = Enumerable.Empty<UserDto>().AsQueryable();
            alert?.AddAlert("Vui lòng nhập email để tìm kiếm user", AlertType.Warning, Constants.DismissAlertAfter5Seconds);
        }
        else
        {
            string searchTerm = searchValue.Trim().ToLower();

            if (searchTerm.Length > 0)
            {
                var result = await IdentityService.SearchUserByEmailAsync(searchTerm);
                if (result.Success && result.Data != null)
                {
                    des = $"Tổng cộng: {result.Data.Count}";
                    items = result.Data.AsQueryable();
                }
                else
                {
                    // Handle error case, e.g., log the error or show a message to the user
                    items = Enumerable.Empty<UserDto>().AsQueryable();
                    alert?.AddAlert("Không thể lấy dữ liệu user", AlertType.Error, Constants.DismissAlertAfter5Seconds);
                }
            }
        }
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/account/users/details/{id}");
    }
}
