@inject IIdentityService identityService
@if (items is null)
{
    <FluentProgressRing />
}
else
{
    <FluentLabel>
        <strong>Roles: </strong> @string.Join(", ", items)
    </FluentLabel>
}

@code {
    IQueryable<string>? items;
    protected override async Task OnInitializedAsync()
    {
        var result = await identityService.GetRoleNamesAsync();
        if (result.Success && result.Data is not null)
        {
            items = result.Data.AsQueryable();
        }
        else
        {
            Console.WriteLine("Failed to retrieve role names: " + result.ErrorMessage?.ToLine());
        }
    }
}
