@page "/transactions/list"
@inject ITransactionService transactionService
@inject NavigationManager navigationManager
@using InfoManager.Shared.Dtos.Transactions

<PageHeader Title="Danh sách giao dịch" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/transactions/create"))>Tạo mới</FluentButton>

        <PaginatedTable TItem="TransactionSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="TransactionSummaryDto" TProp="string" Title="Nội dung" Property="@(x => x.Description)" />
            <PropertyColumn TGridItem="TransactionSummaryDto" TProp="string" Title="Danh mục" Property="@(x => x.CategoryName)" />
            <PropertyColumn TGridItem="TransactionSummaryDto" TProp="decimal" Title="Số tiền" Property="@(x => x.Amount)" Sortable="true" />
           
            <TemplateColumn TGridItem="TransactionSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>
@code {
    PaginatedList<TransactionSummaryDto>? paginatedList;
    bool isLoading = false;
    private int currentPage = 1;
    int pageSize = Constants.PageSize;
    Alert? alertComponent;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await transactionService.GetTransactionsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("TransactionSummaryDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        isLoading = true;
        currentPage = page; // Update the current page
        try
        {
            var result = await transactionService.GetTransactionsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("TransactionSummaryDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/transactions/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/transactions/update/{id}");
    }
}