@page "/HistoricalEvents/update/{Id}"
@page "/HistoricalEvents/create"
@using InfoManager.ModelClient.HistoricalEvents
@inject IHistoricalEventService historicalEventService
@inject NavigationManager navigationManager


<PageHeader Title="Quản lý sự kiện lịch sử" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
            <FluentLabel Typo="Typography.H4">
                @title
            </FluentLabel>
            @if (updateModel != null)
            {
                <EditForm Model="@updateModel" FormName="updateForm" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <FluentTextArea @bind-Value="@updateModel.Title" Label="Sự kiện" Cols="150" Rows="5" Maxlength="500" />
                    <FluentTextArea @bind-Value="@updateModel.Summary" Label="Tóm tắt" Cols="150" Rows="10" />
                    <DateTimePicker @bind-Value="@eventDate" WithTime="false" Label="Ngày xảy ra sự kiện" />
                    <SelectList @bind-Value="eventTypeSelected" Route="api/enums/HistoricalEventType" Label="Loại sự kiện" />
                    <FluentTextField @bind-Value="@updateModel.Location" Label="Địa điểm" Class="fluent-text-field-wide" />
                    <FluentTextField @bind-Value="@updateModel.ReferenceSource" Label="Nguồn tham khảo" Class="fluent-text-field-wide"/>

                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/historicalEvents/list" />
                </EditForm>
            }
            else if (createModel != null)
            {
                <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                    @* <DataAnnotationsValidator />
                    <ValidationSummary /> *@
                    <FluentTextArea @bind-Value="@createModel.Title" Label="Sự kiện" Cols="150" Rows="5" Maxlength="500" Required="true" />
                    <FluentTextArea @bind-Value="@createModel.Summary" Label="Tóm tắt" Cols="150" Rows="10" Required="true" />
                    <DateTimePicker @bind-Value="@eventDate" WithTime="false" Label="Ngày xảy ra sự kiện" />
                    <SelectList @bind-Value="eventTypeSelected" Route="api/enums/HistoricalEventType" Label="Loại sự kiện" />
                    <FluentTextField @bind-Value="@createModel.Location" Label="Địa điểm" Class="fluent-text-field-wide" />
                    <FluentTextField @bind-Value="@createModel.ReferenceSource" Label="Nguồn tham khảo" Class="fluent-text-field-wide"/>

                    @* Action : create, update *@
                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/historicalEvents/list" />
                </EditForm>
            }
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UpdateHistoricalEventModel? updateModel;
    private CreateHistoricalEventModel? createModel;
    private UpdateHistoricalEventModel? originModel;
    private string? eventTypeSelected;
    private DateTime? eventDate;
    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật sự kiện lịch sử";
            var result = await historicalEventService.GetHistoricalEventByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateHistoricalEventModel(result.Data);
                originModel = new UpdateHistoricalEventModel(result.Data);
                eventDate = result.Data.EventDate.ToDateTime();
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "HistoricalEvent"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Tạo mới sự kiện lịch sử";
            createModel = new CreateHistoricalEventModel();
        }
        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || originModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        updateModel.EventDate = eventDate.ToDateOnly();
        if (!updateModel.HasChanges(originModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        updateModel.EventDate = eventDate?.ToDateOnly() ?? DateOnly.FromDateTime(DateTime.Now);
        updateModel.EventType = Enum.Parse<HistoricalEventType>(eventTypeSelected ?? "0");
        var result = await historicalEventService.UpdateHistoricalEventAsync(Id, updateModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Historical Event"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        createModel.EventDate = eventDate?.ToDateOnly() ?? DateOnly.FromDateTime(DateTime.Now);
        createModel.EventType = Enum.Parse<HistoricalEventType>(eventTypeSelected ?? "0");
        var result = await historicalEventService.CreateHistoricalEventAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Historical Event"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
}
