@page "/HistoricalEvents/Details/{Id}"
@inject IHistoricalEventService historicalEventService

<PageHeader Title="Chi tiết sự kiện lịch sử" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
            <DetailItem Label="Tên" Value="@dto?.Title" />
            <DetailItem Label="Tóm tắt" Value="@dto?.Summary" />
            <DetailItem Label="Loại" Value="@dto?.EventName" />
            <DetailItem Label="Ngày" Value="@dto?.EventDate?.ToString("dd/MM/yyyy")" />
            <DetailItem Label="Địa điểm" Value="@dto?.Location" />
            <DetailItem Label="Nguồn tham khảo" Value="@dto?.ReferenceSource" />
            <EntityActions EntityId="@Id" Folder="historicalEvents" OnDeleteClick="DeleteHandler" />
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }
    Alert? alertComponent;
    bool isLoading = false;
    InfoManager.Shared.Dtos.HistoricalEvents.HistoricalEventDto? dto;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        var result = await historicalEventService.GetHistoricalEventByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNotFoundWithId("Sự kiện lịch sử", Id), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void DeleteHandler()
    {
        var s = $"Xóa sự kiện lịch sử {dto?.Title} (ID: {dto?.Id}) thành công.";
        //call service to delete the category
        alertComponent?.AddAlert(s, AlertType.Success, Constants.DismissAlertAfter10Seconds);
    }
}
