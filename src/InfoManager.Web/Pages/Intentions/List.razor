@page "/intentions/list"
@inject IIntentionService intentionService
@inject NavigationManager navigationManager
@using InfoManager.Shared.Dtos.Intentions
<PageHeader Title="Ý định" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/intentions/create"))>Tạo mới</FluentButton>

        <PaginatedTable TItem="IntentionSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="IntentionSummaryDto" TProp="string" Title="Ý định" Property="@(x => x.Content)" />
            <PropertyColumn TGridItem="IntentionSummaryDto" TProp="bool" Title="Hoàn thành" Property="@(x => x.IsCompleted)" Sortable="true" />
            <PropertyColumn TGridItem="IntentionSummaryDto" TProp="string" Title="Ưu tiên" Property="@(x => x.PriorityName)" />
            <TemplateColumn TGridItem="IntentionSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<IntentionSummaryDto>? paginatedList;
    bool isLoading = false;
    private int currentPage = 1;
    int pageSize = Constants.PageSize;
    Alert? alertComponent;


    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await intentionService.GetIntentionsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("IntentionDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task LoadPageAsync(int page)
    {
        isLoading = true;
        currentPage = page;
        try
        {
            var result = await intentionService.GetIntentionsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("IntentionDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/intentions/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/intentions/update/{id}");
    }
}
