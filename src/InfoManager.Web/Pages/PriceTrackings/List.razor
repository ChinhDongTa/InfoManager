@page "/priceTrackings/list"
@inject IPriceTrackingService PriceTrackingService
@inject NavigationManager navigationManager
@using InfoManager.Shared.Dtos.PriceTrackings
<PageHeader Title="Theo dõi giá" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/priceTrackings/create"))>Tạo mới</FluentButton>

        <PaginatedTable TItem="PriceTrackingSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="PriceTrackingSummaryDto" TProp="string" Title="Tên sản phẩm" Property="@(x => x.ProductName)" />
            <PropertyColumn TGridItem="PriceTrackingSummaryDto" TProp="bool" Title="Hoàn thành" Property="@(x => x.IsPurchased)" Sortable="true" />
            <PropertyColumn TGridItem="PriceTrackingSummaryDto" TProp="decimal" Title="Giá hiện tại" Property="@(x => x.CurrentPrice)" />
            <PropertyColumn TGridItem="PriceTrackingSummaryDto" TProp="decimal?" Title="Giá thấp nhất đã thấy" Property="@(x => x.LowestPriceSeen)" />
            <TemplateColumn TGridItem="PriceTrackingSummaryDto" Context="item" Title="Xem sản phẩm">
                <FluentAnchor Href="@item.ProductUrl">Xem</FluentAnchor>
            </TemplateColumn>
            <TemplateColumn TGridItem="PriceTrackingSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<PriceTrackingSummaryDto>? paginatedList;
    bool isLoading = false;
    private int currentPage = 1;
    int pageSize = Constants.PageSize;
    Alert? alertComponent;
    
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await PriceTrackingService.GetPriceTrackingsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("PriceTrackingDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task LoadPageAsync(int page)
    {
        isLoading = true;
        currentPage = page;
        try
        {
            var result = await PriceTrackingService.GetPriceTrackingsAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("PriceTrackingDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/priceTrackings/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/priceTrackings/update/{id}");
    }
}