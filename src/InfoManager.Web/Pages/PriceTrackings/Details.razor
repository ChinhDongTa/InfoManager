@page "/priceTrackings/details/{id}"
@inject IPriceTrackingService PriceTrackingService

<PageHeader Title="Thông tin chi tiết" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        @if (dto != null)
        {
            <FluentStack Style="margin:10px auto;" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <DetailItem Label="Sản phẩm" Value="@dto.ProductName" />
                    <DetailItem Label="Trạng thái mua" Value=@(dto.IsPurchased ? "Đã mua" : "Chưa mua") />
                    <DetailItem Label="Giá hiện tại" Value=@dto.CurrentPrice.ToVND() />
                    <DetailItem Label="Giá mong muốn" Value=@dto.DesiredPrice.ToVND() />
                    <DetailItem Label="Giá thấp nhất đã thấy" Value=@dto.LowestPriceSeen.ToVND() />
                </FluentStack>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                    <DetailItem Label="Ngày kiểm tra cuối cùng" Value=@dto.LastCheckedDate.ToString() />
                    <DetailItem Label="Liên kết sản phẩm" Value="">
                        <a href="@dto?.ProductUrl" target="_blank">xem sản phẩm</a>
                    </DetailItem>
                    <DetailItem Label="Cửa hàng" Value="@dto.StoreName" />
                    <DetailItem Label="Mô tả" Value="@dto?.Description" />

                    <EntityActions EntityId="@Id" Folder="priceTrackings" OnDeleteClick="DeleteHandler" />
                </FluentStack>
            </FluentStack>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }
    Alert? alertComponent;
    bool isLoading = false;
    InfoManager.Shared.Dtos.PriceTrackings.PriceTrackingDto? dto;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        var result = await PriceTrackingService.GetPriceTrackingByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNotFoundWithId("Price Tracking", Id), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void DeleteHandler()
    {
        var s = $"Xóa theo dõi giá (ID: {dto?.Id}) thành công.";
        //call service to delete the category
        alertComponent?.AddAlert(s, AlertType.Success, Constants.DismissAlertAfter10Seconds);
    }
}