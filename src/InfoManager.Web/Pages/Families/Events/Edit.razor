@page "/families/events/update/{Id}"
@page "/families/events/create"

@inject IFamilyService familyService
@inject NavigationManager navigationManager
@using InfoManager.ModelClient.Families

<PageHeader Title="Quản lý sự kiện gia đình" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="max-width:600px; margin: 20px auto;">
            <FluentLabel Typo="Typography.H4">
                @title
            </FluentLabel>
            @if (updateModel != null)
            {
                <EditForm Model="@updateModel" FormName="updateForm" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <FluentTextArea Label="Mô tả sự kiện" @bind-Value="updateModel.Title" Maxlength="300" />
                        <SelectList Label="Thành viên gia đình" Route="api/selectlist/familyMember" @bind-Value="@updateModel.FamilyMemberId"/>
                        <DateTimePicker @bind-Value="@eventDate" WithTime="false" Label="Ngày sự kiện" />
                        <FluentCheckbox Label="Còn hoạt động ?" @bind-Value="updateModel.IsActive" />
                        <SelectList Label="Loại sự kiện" Route="api/enums/familyEventType" @bind-Value="eventTypeSelected" />
                        <FluentTextField Label="Địa điểm" @bind-Value="updateModel.Location" Maxlength="100" />

                        <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/families/events/list" />
                    </FluentStack>
                </EditForm>
            }
            else if (createModel != null)
            {
                <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
                        @* <DataAnnotationsValidator />
                        <ValidationSummary /> 
     *@
                        <FluentTextArea Label="Mô tả sự kiện" @bind-Value="createModel.Title" Maxlength="300" Required="true" />
                        <SelectList Route="api/selectlist/familyMember" @bind-Value="createModel.FamilyMemberId" Required="true" />
                        <DateTimePicker @bind-Value="@eventDate" WithTime="false" Label="Ngày sự kiện" />
                            <FluentCheckbox Label="Còn hoạt động ?" @bind-Value="createModel.IsActive" />
                        <SelectList Route="api/enums/familyEventType" @bind-Value="eventTypeSelected" Required="true" />
                        <FluentTextField Label="Địa điểm" @bind-Value="createModel.Location" Maxlength="100" />

                    @* Action : create, update *@
                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/families/events/list" />
                    </FluentStack>
                </EditForm>
            }
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UpdateFamilyEventModel? updateModel;
    private CreateFamilyEventModel? createModel;
    private UpdateFamilyEventModel? originModel;

    string?  eventTypeSelected;
    DateTime? eventDate;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật sự kiện gia đình";

            var response = await familyService.GetFamilyEventByIdAsync(Id);
            if (response.Success && response.Data != null)
            {
                updateModel = new UpdateFamilyEventModel(response.Data);
                originModel = new UpdateFamilyEventModel(response.Data);
                eventDate = updateModel.EventDate?.ToDateTime();
                eventTypeSelected = updateModel.EventType.ToString();
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(response.ErrorMessage?.ToLine() ?? "Family event"));
            }
        }
        else
        {
            title = "Tạo mới sự kiện gia đình";
            createModel = new CreateFamilyEventModel();
        }
        IsLoading = false;
    }

    /// <summary>
    /// Phát sinh tình huống các selectList không bind vào xxxId (nếu nó là required như FamilyMemberId, EventType,...) 
    /// của model nên EditForm không biết model có thay đổi hay không và đã phát sinh lỗi khi submit form.
    /// Nên phải tự kiểm tra xem model có thay đổi hay không trước khi gọi service update.
    /// </summary>
    /// <returns></returns>
    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || originModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        updateModel.EventDate = eventDate?.ToDateOnly();
        if (!updateModel.HasChanges(originModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Info, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        //updateModel.FamilyMemberId = familyMemberSelected;
        updateModel.EventType = Enum.Parse<FamilyEventType>(eventTypeSelected ?? string.Empty);
        var result = await familyService.UpdateFamilyEventAsync(Id, updateModel.CreateRequest());

        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "Family Event"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        createModel.EventDate =new DateOnly(eventDate.Value.Year, eventDate.Value.Month, eventDate.Value.Day);
        //createModel.FamilyMemberId = familyMemberSelected!;
        createModel.EventType = Enum.Parse<FamilyEventType>(eventTypeSelected ?? string.Empty);
        var result = await familyService.CreateFamilyEventAsync(createModel.CreateRequest());
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "Family Event"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine()), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
   
}