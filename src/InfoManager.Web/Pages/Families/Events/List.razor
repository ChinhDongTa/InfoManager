@page "/families/events/list"
@inject IFamilyService familyService
@inject NavigationManager navigationManager
@using InfoManager.Shared.Dtos.FamilyEvents

<PageHeader Title="Sự kiện gia đình" />
<Alert @ref="alertComponent" />

<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/families/events/create"))>Tạo mới</FluentButton>
        <PaginatedTable TItem="FamilyEventSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="FamilyEventSummaryDto" TProp="string" Title="Họ và tên" Property="@(x => x.FamilyMemberFullName)" />
            <PropertyColumn TGridItem="FamilyEventSummaryDto" TProp="string" Title="Sự kiện" Property="@(x => x.EventName)" Sortable="true" />
            <PropertyColumn TGridItem="FamilyEventSummaryDto" TProp="DateOnly?" Title="Ngày diễn ra" Property="@(x => x.EventDate)" Sortable="true" />
            <TemplateColumn TGridItem="FamilyEventSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    PaginatedList<FamilyEventSummaryDto>? paginatedList;
    bool isLoading = false;
    private int currentPage = 1;
    int pageSize = Constants.PageSize;
    Alert? alertComponent;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await familyService.GetFamilyEventsAsync(null, currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("FamilyEventSummaryDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        isLoading = true;
        currentPage = page;
        try
        {
            var result = await familyService.GetFamilyEventsAsync(null, page, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData("FamilyEventSummaryDto"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/families/events/update/{id}");
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/families/events/details/{id}");
    }
}
