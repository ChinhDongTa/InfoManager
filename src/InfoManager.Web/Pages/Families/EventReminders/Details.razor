@page "/families/eventReminders/details/{Id}"
@inject IFamilyEventReminderService service

<PageHeader Title="Chi tiết tổ chức sự kiện" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="max-width:600px; margin: 20px auto;">
            <DetailItem Label="Họ tên" Value="@dto?.MemberName" />
            <DetailItem Label="Địa điểm" Value="@dto?.EventTitle" />
            <DetailItem Label="Kênh thông báo" Value="@dto?.Channel.ToDisplayName()" />
            <DetailItem Label="Thông báo trước" Value="@dto?.DaysBefore.ToString()" />
            <DetailItem Label="Đang bật" Value="@(dto?.IsEnabled == true ? "Có" : "Không")" />
            <DetailItem Label="Thời gian nhắc" Value="@dto?.RemindTime?.ToString()" />
            <DetailItem Label="Ghi chú" Value="@dto?.Note" />
            <EntityActions EntityId="@Id" Folder="families/eventReminders" OnDeleteClick="DeleteHandler" />
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }
    Alert? alertComponent;
    bool isLoading = false;
    InfoManager.Shared.Dtos.FamilyEventReminders.FamilyEventReminderDto? dto;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        var result = await service.GetFamilyEventReminderByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNotFoundWithId("Family event reminder", Id), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void DeleteHandler()
    {
        var s = $"Xóa Family Event Reminder (ID: {dto?.Id}) thành công.";
        //call service to delete the category
        alertComponent?.AddAlert(s, AlertType.Success, Constants.DismissAlertAfter10Seconds);
    }
}