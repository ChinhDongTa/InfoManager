@page "/families/eventOccurrences/list/{familyEventId}"
@page "/families/eventOccurrences/list"

@inject NavigationManager navigationManager
@inject IFamilyEventOccurrenceService service
@using InfoManager.Shared.Dtos.FamilyEventOccurrences
<PageHeader Title="Danh sách tổ chức sự kiện" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentButton IconStart="@(new Icons.Filled.Size16.Add())" OnClick=@(() => navigationManager.NavigateTo("/families/create"))>
            Tạo mới
        </FluentButton>
        <PaginatedTable TItem="FamilyEventOccurrenceSummaryDto" Data="paginatedList" PageSize="pageSize" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
            <PropertyColumn TGridItem="FamilyEventOccurrenceSummaryDto" TProp="string" Title="Họ tên" Property="@(x => x.MemberName)" Sortable="true" />
            <PropertyColumn TGridItem="FamilyEventOccurrenceSummaryDto" TProp="string" Title="Sự kiện" Property="@(x => x.EventTitle)" />
            <PropertyColumn TGridItem="FamilyEventOccurrenceSummaryDto" TProp="DateOnly?" Title="Ngày" Property="@(x => x.OccurrenceDate)" />
            <PropertyColumn TGridItem="FamilyEventOccurrenceSummaryDto" TProp="string" Title="Chi phí" Property="@(x => x.Cost.ToVND())" />
            <TemplateColumn TGridItem="FamilyEventOccurrenceSummaryDto" Context="item" Title="Actions">
                <FluentIcon Value="@(new Icons.Filled.Size20.Eye())" @onclick=@(() => ViewHandler(item.Id)) />
                <FluentIcon Value="@(new Icons.Filled.Size20.Edit())" @onclick=@(() => EditHandler(item.Id)) />
            </TemplateColumn>
        </PaginatedTable>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? familyEventId { get; set; }
    PaginatedList<FamilyEventOccurrenceSummaryDto>? paginatedList;
    Alert? alertComponent;
    bool isLoading = false;
    int pageSize = Models.Constants.PageSize;
    int currentPage = 1;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageAsync(currentPage);
    }
    private async Task LoadPageAsync(int page)
    {
        currentPage = page;
        isLoading = true;
        if (string.IsNullOrEmpty(familyEventId))
        {

            var result = await service.GetFamilyEventOccurrencesAsync(currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Family event occurrences"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            var result = await service.GetFamilyEventOccurrencesByMemberIdAsync(familyEventId, currentPage, pageSize);
            if (result.Success && result.Data != null)
            {
                paginatedList = result.Data;
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "Family event occurrences"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        isLoading = false;
    }

    private void ViewHandler(string id)
    {
        navigationManager.NavigateTo($"/families/eventoccurrences/details/{id}");
    }

    private void EditHandler(string id)
    {
        navigationManager.NavigateTo($"/families/eventoccurrences/edit/{id}");
    }
}
