@page "/families/eventOccurrences/details/{Id}"
@inject IFamilyEventOccurrenceService service
<PageHeader Title="Chi tiết tổ chức sự kiện" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="isLoading" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="max-width:600px; margin: 20px auto;">
            <DetailItem Label="Họ tên" Value="@dto?.MemberName" />
            <DetailItem Label="Ngày tổ chức" Value="@dto?.OccurrenceDate?.ToString("dd/MM/yyyy")" />
            <DetailItem Label="Sự kiện" Value="@dto?.EventTitle" />
            <DetailItem Label="Địa điểm" Value="@dto?.Location" />
            <DetailItem Label="Chi phí" Value="@dto?.Cost.ToVND()" />
            <DetailItem Label="Ghi chú" Value="@dto?.Notes" />
            <EntityActions EntityId="@Id" Folder="families/eventOccurrences" OnDeleteClick="DeleteHandler" />
        </FluentStack>
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }
    Alert? alertComponent;
    bool isLoading = false;
    InfoManager.Shared.Dtos.FamilyEventOccurrences.FamilyEventOccurrenceDto? dto;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        var result = await service.GetFamilyEventOccurrenceByIdAsync(Id);
        if (result.Success && result.Data != null)
        {
            dto = result.Data;
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNotFoundWithId("Family event occurrence",Id), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        isLoading = false;
    }

    private void DeleteHandler()
    {
        var s = $"Xóa Family Event Occurrence (ID: {dto?.Id}) thành công.";
        //call service to delete the category
        alertComponent?.AddAlert(s, AlertType.Success, Constants.DismissAlertAfter10Seconds);
    }
}