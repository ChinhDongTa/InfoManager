@page "/families/update/{Id}"
@page "/families/create"
@inject IFamilyService familyService
@using InfoManager.ModelClient.Families

<PageHeader Title="Quản lý thành viên gia đình" />
<Alert @ref="alertComponent" />
<AuthorizeView>
    <Authorized>
        <LoadingOverlay IsLoading="IsLoading" />
        <FluentLabel Typo="Typography.H4">
            @title
        </FluentLabel>
        @if (updateModel != null)
        {
              <EditForm Model="@updateModel" FormName="updateForm" Context="updateContext" OnValidSubmit="@HandleUpdateValidSubmit">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <FluentTextField Label="Họ và tên" @bind-Value="updateModel.FullName" Maxlength="100" />
                        <DateTimePicker @bind-Value="@birthDate" WithTime="false" Label="Ngày sinh"  />
                        <DateTimePicker @bind-Value="@deathDate" WithTime="false" Label="Ngày mất" />
                        <SelectList Label="Giới tính" @bind-SelectedOption="@genderSelected" Route="api/enums/gender" DefaultId="@updateModel.Gender.ToIntString()" />
                        <SelectList Label="Quan hệ gia đình" @bind-SelectedOption="@familyRelationSelected" Route="api/selectList/familyRelation" DefaultId="@updateModel.FamilyRelationId" />
                        <FluentTextField Label="Email" @bind-Value="updateModel.Email" Maxlength="200" />
                        <FluentTextField Label="Phone" @bind-Value="updateModel.PhoneNumber" Maxlength="50" />
                        <FluentTextArea Label="Ghi chú" @bind-Value="updateModel.Note" />
                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/families/list" />
                </FluentStack>
            </EditForm>
        }
        else if (createModel != null)
        {
            <EditForm Model="@createModel" FormName="createForm" Context="createContext" OnValidSubmit="@HandleCreateValidSubmit">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Left" Style="width:100%; margin: 20px auto;">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <FluentTextField Label="Họ và tên" @bind-Value="createModel.FullName" Maxlength="100" Required="true" />
                    <DateTimePicker @bind-Value="@birthDate" WithTime="false" Label="Ngày sinh" Required="true"  />
                    <DateTimePicker @bind-Value="@deathDate" WithTime="false" Label="Ngày mất" />
                    <SelectList Label="Giới tính" @bind-SelectedOption="@genderSelected" Route="api/enums/gender" DefaultId="@createModel.Gender.ToIntString()" />
                    <SelectList Label="Quan hệ gia đình" @bind-SelectedOption="@familyRelationSelected" Route="api/selectList/familyRelation" DefaultId="@createModel.FamilyRelationId" />
                    <FluentTextField Label="Email" @bind-Value="createModel.Email" Maxlength="200" />
                    <FluentTextField Label="Phone" @bind-Value="createModel.PhoneNumber" Maxlength="50" />
                    <FluentTextArea Label="Ghi chú" @bind-Value="createModel.Note" />

                    <FormActionButtons IsSaving="@IsSaving" SaveText="Lưu" CancelText="Quay lại danh sách" CancelUrl="/families/list" />
                </FluentStack>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedMessage />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public required string Id { get; set; }

    private UpdateFamilyMemberModel? updateModel;
    private UpdateFamilyMemberModel? originalModel;
    private CreateFamilyMemberModel? createModel;

    Alert? alertComponent;
    bool IsSaving = false;
    bool IsLoading = false;
    string? title = null;

    SelectListItemDto? genderSelected, familyRelationSelected;
    private DateTime? birthDate, deathDate;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        if (!string.IsNullOrEmpty(Id))
        {
            title = "Cập nhật thành viên gia đình";
            var result = await familyService.GetFamilyMemberByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                updateModel = new UpdateFamilyMemberModel(result.Data);

                originalModel = new UpdateFamilyMemberModel(result.Data);   
                birthDate = result.Data.BirthDate.ToDateTime();
            }
            else
            {
                alertComponent?.AddAlert(ErrorHelpers.GetErrorCannotRetrieveData(result.ErrorMessage?.ToLine() ?? "GetFamilyMember"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            }
        }
        else
        {
            title = "Thêm thành viên gia đình";
            createModel = new CreateFamilyMemberModel();
        }
        IsLoading = false;
    }

    private async Task HandleUpdateValidSubmit()
    {
        IsSaving = true;
        if (updateModel == null || originalModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Update Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        if (updateModel.Equals(originalModel))
        {
            alertComponent?.AddAlert(ErrorHelpers.GetInfoCustom(), AlertType.Warning, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }
        updateModel.BirthDate = birthDate.ToDateOnly();
        updateModel.DeathDate = deathDate.ToDateOnly();
        updateModel.FamilyRelationId = familyRelationSelected?.Id;
        updateModel.Gender = GetGenderFromString(genderSelected!.Id);
        var updateResult = updateModel.CreateRequest();
        var result = await familyService.UpdateFamilyMemberAsync(Id, updateResult);
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Update, "family member"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine() ?? "UpdateFamilyMember"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }

    private async Task HandleCreateValidSubmit()
    {
        IsSaving = true;
        if (createModel == null)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorNull("Create Model"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
            IsSaving = false;
            return;
        }

        createModel.BirthDate = new DateOnly(birthDate.Value.Year, birthDate.Value.Month, birthDate.Value.Day);
        createModel.DeathDate = deathDate.ToDateOnly();
        createModel.FamilyRelationId = familyRelationSelected?.Id;

        createModel.Gender = GetGenderFromString(genderSelected!.Id);

        var createRequest = createModel.CreateRequest();
        var result = await familyService.CreateFamilyMemberAsync(createRequest);
        if (result.Success)
        {
            alertComponent?.AddAlert(ErrorHelpers.GetSuccessAction(InfoManager.Enum.ActionType.Create, "family member"), AlertType.Success, Constants.DismissAlertAfter10Seconds);
        }
        else
        {
            alertComponent?.AddAlert(ErrorHelpers.GetErrorCustom(result.ErrorMessage?.ToLine() ?? "CreateFamilyMember"), AlertType.Error, Constants.DismissAlertAfter10Seconds);
        }
        IsSaving = false;
    }
    private Gender GetGenderFromString(string intString) {
        return (Gender)int.Parse(intString);
    }
}