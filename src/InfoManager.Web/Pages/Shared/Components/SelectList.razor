@using InfoManager.Shared.Dtos.Common
@inject ISelectListService service

@if (IsLoading)
{
    <FluentProgressRing />
}
else if (HasError)
{
    <FluentLabel Typo="Typography.Body" Style="color: var(--error);" Title="@ErrorMessage">
        ⚠️ @ErrorMessage
    </FluentLabel>
}
else if (Items.Any())
{
    <FluentSelect TOption="SelectListItemDto"
                  Items="@Items"
                  @bind-Value="Value"
                  OptionValue="@(item => item.Id ?? string.Empty)"
                  OptionText="@(item => item.Name ?? string.Empty)"
                  Label="@Label"
                  Required="@Required"
                  Placeholder="@(string.IsNullOrEmpty(Placeholder) ? "Chọn..." : Placeholder)"
                  Disabled="@Disabled"
                  Style="@Style"
                  Class="@Class"
                  @attributes="AdditionalAttributes" />
}
else
{
    <FluentLabel Typo="Typography.Body">Không có dữ liệu</FluentLabel>
}

@code {
    [Parameter] public required string Route { get; set; } = string.Empty;  
    [Parameter] public bool UsePublicApi { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? _value;

    [Parameter]
    public string? Value
    {
        get => _value;
        set
        {
            if (_value == value) return;
            _value = value;
            _ = ValueChanged.InvokeAsync(value);
        }
    }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private List<SelectListItemDto> Items { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool HasError { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Route))
        {
            HasError = true;
            ErrorMessage = "Route phải có giá trị.";
            IsLoading = false;
            return;
        }
        await LoadItems();
    }

    private async Task LoadItems()
    {
        try
        {
            var kind = UsePublicApi ? ApiClientKind.Public : ApiClientKind.Protected;

            var apiResult = await service.GetAsync(Route, kind);

            if (apiResult != null)
            {
                Items = apiResult.OrderBy(x => x.Name).ToList();
            }
            else
            {
                HasError = true;
                ErrorMessage = "Không thể tải danh sách.";
            }
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}